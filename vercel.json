{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install && npm install --prefix backoffice && npm install --prefix server",
  "buildCommand": "npm run build:prod",
  "crons": [
    {
      "path": "/api/cron/orders",
      "schedule": "30 20 * * *"
    }
  ]
}
